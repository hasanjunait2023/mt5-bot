# ── Supabase Database ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── NVIDIA NIM API ────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your_key_here

# ── Notion Integration ────────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_key_here

# ── Telegram Bot / HQ ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Legacy single private chat (kept as fallback if no HQ group is set up).
TELEGRAM_CHAT_ID=your_chat_id_here
# HQ supergroup id (negative, e.g. -1001234567890). Normally auto-filled by
# running /hq_setup in the group; set here only to override.
TELEGRAM_GROUP_CHAT_ID=
# Set to 1 to log notifications to logs/telegram/outbox.jsonl without calling
# Telegram (useful for local testing).
TELEGRAM_HQ_DRYRUN=

# ── Deployment profile ───────────────────────────────────────────────────────
# Which machine profile the orchestrator runs. "vps" runs the full live stack
# (MT5 + TradingView + Telegram + dashboard); "local" runs nothing live (the
# local PC is a dev/standby box — prevents double-trading + Telegram 409).
DEPLOYMENT_MODE=vps
# Host the bridge listens on / agents reach it at. localhost when everything is
# co-located on one machine (current VPS setup). Only change for a split deploy.
MT5_BRIDGE_HOST=localhost
MT5_BRIDGE_URL=http://localhost:8090

# ── Dashboard security (REQUIRED on a public VPS) ────────────────────────────
# Without these the dashboard is open (no auth, CORS *). Set on the VPS.
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
DASHBOARD_TOKEN_TTL_HOURS=12
# Comma-separated allowed origins, e.g. https://yourdomain,http://VPS_IP:8000
DASHBOARD_ALLOWED_ORIGINS=
# Set to 1 only on a box WITHOUT MetaTrader5 (disables the in-process signal
# engine). Leave unset on the VPS, which has MT5.
DASHBOARD_DISABLE_SIGNALS=

# ── TradingView session watchdog ─────────────────────────────────────────────
# Set 1 to pause auto-reconnect (so you can use TradingView on your own device
# without the VPS reclaiming the single session). Or use: python -m
# trading_agents.tv_desk.connection_watchdog --pause <minutes>
TV_WATCHDOG_PAUSE=
